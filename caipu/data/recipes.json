  {
    "id": "001",
    "title": "经典西红柿炒鸡蛋",
    "author": "大厨小明",
    "image_url": "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600&h=400&fit=crop",
    "category": "午餐",
    "prep_time": "10分钟",
    "cook_time": "5分钟",
    "difficulty": "简单",
    "calories": 180,
    "rating": 4.8,
    "tags": ["家常菜", "快手菜", "素食", "咸"],
    "ingredients": [
      {"name": "鸡蛋", "amount": "3个"},
      {"name": "西红柿", "amount": "2个"},
      {"name": "糖", "amount": "1勺"},
      {"name": "盐", "amount": "适量"},
      {"name": "葱", "amount": "少许"},
      {"name": "食用油", "amount": "适量"}
    ],
    "steps": [
      "西红柿切块，鸡蛋打散加少许盐搅拌均匀。",
      "热锅凉油，倒入蛋液，待底部凝固后快速翻炒成大块，盛出备用。",
      "锅中留底油，放入西红柿块，中火翻炒至出汁。",
      "加入一勺糖提鲜，倒入炒好的鸡蛋混合翻炒均匀。",
      "撒上葱花，即可出锅装盘。"
    ]
  },
  {
    "id": "002",
