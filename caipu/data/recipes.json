    "author": "川味大师",
    "image_url": "https://images.unsplash.com/photo-1525755662778-989d0524087e?w=600&h=400&fit=crop",
    "category": "午餐",
    "prep_time": "20分钟",
    "cook_time": "10分钟",
    "difficulty": "中等",
    "calories": 320,
    "rating": 4.9,
    "tags": ["川菜", "下饭菜", "辣"],
    "ingredients": [
      {"name": "鸡胸肉", "amount": "300克"},
      {"name": "花生米", "amount": "50克"},
      {"name": "干辣椒", "amount": "10个"},
      {"name": "花椒", "amount": "1小勺"},
      {"name": "葱", "amount": "2根"},
      {"name": "蒜", "amount": "3瓣"},
      {"name": "姜", "amount": "3片"},
      {"name": "酱油", "amount": "2勺"},
      {"name": "醋", "amount": "1勺"},
      {"name": "糖", "amount": "1勺"},
      {"name": "淀粉", "amount": "适量"}
    ],
    "steps": [
      "鸡胸肉切丁，加酱油、料酒、淀粉腌制15分钟。",
      "花生米小火炒至金黄酥脆，盛出备用。",
      "碗中调酱汁：酱油、醋、糖、淀粉加少许水拌匀。",
      "热锅下油，爆香干辣椒和花椒至变色出香。",
      "下入鸡丁大火翻炒至变色，加入葱姜蒜炒香。",
      "倒入调好的酱汁快速翻炒均匀，最后撒入花生米即可。"
    ]
  },
  {
    "id": "003",
    "title": "红烧肉",
    "author": "家常味道",
    "image_url": "https://images.unsplash.com/photo-1544025162-d76694265947?w=600&h=400&fit=crop",
    "category": "晚餐",
    "prep_time": "15分钟",
    "cook_time": "60分钟",
    "difficulty": "中等",
    "calories": 450,
    "rating": 4.7,
    "tags": ["家常菜", "下饭菜", "咸", "硬菜"],
    "ingredients": [
      {"name": "五花肉", "amount": "500克"},
      {"name": "冰糖", "amount": "30克"},
      {"name": "酱油", "amount": "3勺"},
      {"name": "料酒", "amount": "2勺"},
      {"name": "八角", "amount": "2个"},
      {"name": "桂皮", "amount": "1小段"},
      {"name": "葱", "amount": "2根"},
      {"name": "姜", "amount": "5片"}
    ],
    "steps": [
      "五花肉切3厘米见方的块，冷水下锅焯水去血沫，捞出洗净。",
      "锅中放少许油，小火放入冰糖炒至枣红色起大泡。",
      "下入五花肉翻炒上色，加入葱姜、八角、桂皮炒香。",
      "加入酱油、料酒翻炒均匀，加入没过肉的热水。",
      "大火烧开后转小火炖45分钟至肉烂。",
      "大火收汁至汤汁浓稠即可出锅。"
    ]
  },
  {
    "id": "004",
    "title": "蛋炒饭",
    "author": "快手小厨",
    "image_url": "https://images.unsplash.com/photo-1603133872878-684f208fb84b?w=600&h=400&fit=crop",
    "category": "早餐",
    "prep_time": "5分钟",
    "cook_time": "5分钟",
    "difficulty": "简单",
    "calories": 350,
    "rating": 4.5,
    "tags": ["快手菜", "主食", "咸"],
    "ingredients": [
      {"name": "隔夜米饭", "amount": "1碗"},
      {"name": "鸡蛋", "amount": "2个"},
      {"name": "葱", "amount": "2根"},
      {"name": "盐", "amount": "适量"},
      {"name": "食用油", "amount": "适量"}
    ],
    "steps": [
      "隔夜米饭用手打散，鸡蛋打散备用，葱切葱花。",
      "热锅下油，倒入蛋液快速滑炒至半凝固。",
      "立即倒入米饭，大火快速翻炒，让每一粒米都裹上蛋液。",
      "加盐调味，撒入葱花翻炒均匀即可出锅。"
    ]
  },
  {
    "id": "005",
    "title": "酸辣土豆丝",
    "author": "家常味道",
    "image_url": "https://images.unsplash.com/photo-1512058564366-18510be2db19?w=600&h=400&fit=crop",
    "category": "午餐",
