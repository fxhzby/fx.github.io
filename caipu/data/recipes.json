    "category": "晚餐",
    "prep_time": "10分钟",
    "cook_time": "25分钟",
    "difficulty": "简单",
    "calories": 280,
    "rating": 4.8,
    "tags": ["家常菜", "甜", "下饭菜"],
    "ingredients": [
      {"name": "鸡翅中", "amount": "10个"},
      {"name": "可乐", "amount": "1罐（330ml）"},
      {"name": "酱油", "amount": "2勺"},
      {"name": "姜", "amount": "3片"},
      {"name": "料酒", "amount": "1勺"},
      {"name": "盐", "amount": "少许"}
    ],
    "steps": [
      "鸡翅两面各划两刀方便入味，冷水下锅焯水捞出。",
      "热锅少许油，放入鸡翅煎至两面金黄。",
      "加入姜片、酱油、料酒翻炒均匀。",
      "倒入可乐没过鸡翅，大火烧开转小火炖15分钟。",
      "大火收汁至汤汁浓稠发亮即可。"
    ]
  },
